{
  "name": "gdziekibel-pl",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:staging": "node scripts/verify-staging-target.mjs && playwright test --config playwright.staging.config.ts",
    "test:performance": "playwright test --config playwright.performance.config.ts",
    "test:fullstack": "playwright test --config playwright.fullstack.config.ts",
    "audit:dependencies": "npm audit --audit-level=high",
    "db:check": "tsx scripts/check-postgis.ts",
    "db:migrate": "node-pg-migrate up -m db/migrations",
    "db:provision:staging-app-role": "tsx scripts/provision-staging-app-role.ts",
    "db:ingest:osm-warsaw": "tsx scripts/ingest-osm-warsaw.ts"
  },
  "dependencies": {
    "maplibre-gl": "6.9.0",
    "maplibre-gl": "^6.9.0",
    "next": "15.5.25",
    "pg": "8.16.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.55.1",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.4",
    "node-pg-migrate": "8.0.4",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vitest": "5.0.0"
  },
  "overrides": {
    "postcss": "8.5.28",
    "sharp": "0.35.4"
  }
}
